model Question {
    id String @id @default(cuid())

    question       String  @unique @db.Text
    banglaQuestion String? @unique @db.Text

    options       Json
    correctAnswer String

    explanation       String? @db.Text
    banglaExplanation String? @db.Text

    isActive Boolean @default(true)

    subjectId String?
    topicId   String?
    testId    String?

    subject Subject? @relation(fields: [subjectId], references: [id], onDelete: Cascade)
    topic   Topic?   @relation(fields: [topicId], references: [id], onDelete: SetNull)
    test    Test?    @relation(fields: [testId], references: [id], onDelete: Cascade)

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    @@unique([subjectId, question])
    @@unique([topicId, question])
    @@unique([testId, question])
    @@index([subjectId, isActive])
    @@index([topicId, isActive])
}
