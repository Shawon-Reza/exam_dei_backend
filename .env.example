```env
# Application
NODE_ENV=development
PORT=5000
FRONTEND_URL=http://localhost:3000

# PostgreSQL Database (Local)
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/DATABASE_NAME?schema=public"

# PostgreSQL Database (Prisma Cloud / Production)
# DATABASE_URL="postgres://USER:PASSWORD@HOST:5432/DATABASE_NAME?sslmode=require"

# Better Auth
BETTER_AUTH_SECRET="replace_with_a_secure_random_secret"
BETTER_AUTH_URL="http://localhost:5000"

# Email Service (Nodemailer / Gmail SMTP)
SMTP_USER="your_email@gmail.com"
SMTP_PASS="your_gmail_app_password"
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587

# JWT Configuration
accessTokenSecret="replace_with_a_secure_access_token_secret"
refreshTokenSecret="replace_with_a_secure_refresh_token_secret"
accessTokenExpiration=1d
refreshTokenExpiration=7d

# Google OAuth
GOOGLE_CLIENT_ID="your_google_client_id"
GOOGLE_CLIENT_SECRET="your_google_client_secret"
```
 
